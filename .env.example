# Database
DATABASE_URL=postgresql+psycopg2://postgres:your-password@localhost:5432/inventory_db

# JWT security (replace both values with long, unique random secrets)
JWT_ACCESSTOKEN_SECRET_KEY=replace-with-a-long-random-access-token-secret
JWT_REFRESHTOKEN_SECRET_KEY=replace-with-a-long-random-refresh-token-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_MINUTES=10080
